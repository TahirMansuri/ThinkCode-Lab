{
  "hosting": {
    "site": "thinkcode-lab",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "Cross-Origin-Embedder-Policy",
            "value": "require-corp"
          }
        ]
      },
      {
        "source": "/ThinkCodeLab.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"ThinkCodeLab.apk\""
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "cross-origin"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/apk",
        "destination": "/ThinkCodeLab.apk",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/download",
        "destination": "/download.html"
      }
    ]
  }
}
