{
  "hosting": {
    "site": "thinkcode-lab",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "Cross-Origin-Embedder-Policy",
            "value": "require-corp"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/ThinkCodeLab.apk",
        "destination": "https://github.com/TahirMansuri/ThinkCode-Lab/releases/download/v1.3.2/ThinkCodeLab.apk",
        "type": 302
      },
      {
        "source": "/apk",
        "destination": "https://github.com/TahirMansuri/ThinkCode-Lab/releases/download/v1.3.2/ThinkCodeLab.apk",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/download",
        "destination": "/download.html"
      }
    ]
  }
}
